<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the Plesk (Windows) host, where the site runs as a Node app
  under iisnode with this folder as both the application root and the document
  root. Plesk registers server.js with iisnode when Node.js is enabled for the
  domain; what it does not add is the routing, which is what this file is for.

  It lives at the repo root so every git deploy puts it back in place. Plesk
  may add sections of its own to the deployed copy - that is expected.
-->
<configuration>
  <system.webServer>

    <!--
      Every request goes to the Next.js server. Without this only "/" reaches
      it (as the default document) and every other URL is looked up as a file
      in this folder: pages 404, and project files such as package.json are
      handed out as downloads. With it, nothing here is served as a plain file.
    -->
    <rewrite>
      <rules>
        <rule name="nextjs" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Let the app's own error responses through. Otherwise IIS swaps in its
      error page for any 4xx/5xx, which would replace the site's 404 page and
      the JSON the contact form reads when a submission is rejected.
    -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
