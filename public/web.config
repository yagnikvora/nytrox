<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the static export (Plesk for Windows).

  This lives in `public/` so `next build` copies it to `out/web.config` on
  every build - the document root is `out`, so it has to be emitted there
  rather than kept at the repo root.

  Nothing here is needed on Apache/nginx; the export is plain files.
-->
<configuration>
  <system.webServer>

    <!-- trailingSlash:true emits `about/index.html`, so /about/ resolves here. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- `remove` first: re-adding a type IIS already knows is a 500.19. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!--
      If the site 500.19s after deploying, this is the section to drop first -
      some Plesk/IIS setups lock httpErrors at the server level.
    -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>

  <!-- Hashed filenames, so they can be cached forever. -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
