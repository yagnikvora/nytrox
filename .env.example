# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git - never commit real keys. On Plesk, either create .env.local in the
# application root on the server or add these under Node.js > Custom
# environment variables, then restart the app.

# --- Email (Resend) ---------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Leave both unset to send from Resend's shared sender to
# nytroxai@gmail.com. The shared sender only delivers to the address the Resend
# account was created with; to send from your own domain, verify it in Resend
# and set CONTACT_FROM_EMAIL to an address on it.
# CONTACT_FROM_EMAIL="Nytrox Website <hello@yourdomain.com>"
# CONTACT_TO_EMAIL=nytroxai@gmail.com

# --- Sanity -----------------------------------------------------------------
# Project ID from https://www.sanity.io/manage
SANITY_PROJECT_ID=
SANITY_DATASET=production
# A token with Editor (write) permission: sanity.io/manage > project > API > Tokens
SANITY_API_TOKEN=
